# esa API設定
ESA_API_KEY=your_esa_api_key_here
ESA_TEAM_NAME=your_team_name

# Discord Bot設定
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# timesチャンネルのプレフィックス（このprefixで始まるチャンネルを通知対象にする）
# 例: #times-wata_haru の場合、プレフィックスは "times-"
DISCORD_TIMES_CHANNEL_PREFIX=times-

# LLM API設定 (Google Gemini)
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-7.5-flash
LLM_CONFIDENCE_THRESHOLD=0.7

# スケジュール設定 (cron式)
# 金曜日9:00: 今週分のタスクの達成度チェック
SCHEDULE_PROGRESS_CHECK=0 9 * * 5
# 金曜日13:00: 週報の「来週やること」を送信
SCHEDULE_WEEKLY_TASKS=0 13 * * 5

# ジョブモード(--job=)実行後の自動終了時間（分）。0で無効
AUTO_SHUTDOWN_MINUTES=0

# データベース設定
DATABASE_PATH=./db/tasks.db